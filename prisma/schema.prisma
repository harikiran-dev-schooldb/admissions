generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EligibilityCheck {
  id            String   @id @default(cuid())
  student       String?
  parent        String?
  mobile        String?
  dob           String
  calculatedAge String
  eligibleClass String
  academicYear  String
  converted     Boolean  @default(false)
  admissionId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admission {
  id             String               @id @default(cuid())
  enquiryNo      String               @unique
  academicYear   String               @default("2026-27")
  year           AcademicYear         @relation(fields: [academicYear], references: [academicYear], onUpdate: Cascade, onDelete: Restrict)
  /// *
  ///    * STUDENT DETAILS
  student        String
  parent         String?
  admClass       String
  mobile         String
  dob            String?
  age            String?
  eligibleStatus String?
  entrance       EntranceStatus       @default(NOT_STARTED)
  interview      InterviewStatus      @default(NOT_STARTED)
  finalAdmission FinalAdmissionStatus @default(PENDING)
  updatedAt      DateTime             @updatedAt
  admissionGiven AdmissionGivenStatus @default(NOT_GIVEN)
  /// *
  ///    * ADMISSION PROCESS
  application    ApplicationStatus    @default(NO)
  eligibleClass  String?
  /// *
  ///    * DATES
  enquiryDate    DateTime             @default(now())

  @@index([academicYear])
}

model FeeRecord {
  id String @id @default(cuid())

  academicYear String
  year AcademicYear @relation(fields: [academicYear], references: [academicYear], onUpdate: Cascade, onDelete: Restrict)

  termFee Int @map("term")

  annualFees Int

  age String?

  className String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([academicYear, className])
}

model AcademicYear {
  admissions Admission[]
  feeRecords FeeRecord[]
  id           String    @id @default(cuid())
  academicYear String    @unique
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WorkspaceMember {
  id        String        @id @default(cuid())
  email     String        @unique
  role      WorkspaceRole
  isActive  Boolean       @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([role, isActive])
}

model WorkspaceMemberAudit {
  id           String        @id @default(cuid())
  memberEmail  String
  actorEmail   String
  action       String
  beforeRole   WorkspaceRole?
  afterRole    WorkspaceRole?
  beforeActive Boolean?
  afterActive  Boolean?
  createdAt    DateTime      @default(now())

  @@index([createdAt])
  @@index([memberEmail, createdAt])
}

enum WorkspaceRole {
  ADMIN
  STAFF
}

model AdmissionConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Eligibility {
  id        String   @id @default(cuid())
  age       Int
  className String   @map("class")
  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  NO
  YES
  SUBMITTED
}

enum EntranceStatus {
  NOT_STARTED
  PASS
  FAIL
  PENDING
  NOT_REQUIRED
}

enum InterviewStatus {
  NOT_STARTED
  SELECTED
  REJECTED
  PENDING
}

enum AdmissionGivenStatus {
  NOT_GIVEN
  GIVEN
}

enum FinalAdmissionStatus {
  PENDING
  ADMITTED
  CANCELLED
}
