generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EligibilityCheck {
  id            String   @id @default(cuid())
  student       String?
  parent        String?
  mobile        String?
  dob           String
  calculatedAge String
  eligibleClass String
  academicYear  String
  converted     Boolean  @default(false)
  admissionId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admission {
  id             String               @id @default(cuid())
  enquiryNo      String               @unique
  academicYear   String               @default("2026-27")
  year           AcademicYear         @relation(fields: [academicYear], references: [academicYear], onUpdate: Cascade, onDelete: Restrict)
  /// *
  ///    * STUDENT DETAILS
  student        String
  parent         String?
  admClass       String
  mobile         String
  dob            String?
  age            String?
  eligibleStatus String?
  entrance       EntranceStatus       @default(NOT_STARTED)
  interview      InterviewStatus      @default(NOT_STARTED)
  finalAdmission FinalAdmissionStatus @default(PENDING)
  updatedAt      DateTime             @updatedAt
  admissionGiven AdmissionGivenStatus @default(NOT_GIVEN)
  /// *
  ///    * ADMISSION PROCESS
  application    ApplicationStatus    @default(NO)
  eligibleClass  String?
  /// *
  ///    * DATES
  enquiryDate    DateTime             @default(now())
  entranceScheduledAt    DateTime?
  entranceAssignedEmail  String?
  interviewScheduledAt   DateTime?
  interviewAssignedEmail String?

  followUps       AdmissionFollowUp[]

  @@index([academicYear])
}

model FeeRecord {
  id String @id @default(cuid())

  academicYear String
  year AcademicYear @relation(fields: [academicYear], references: [academicYear], onUpdate: Cascade, onDelete: Restrict)

  termFee Int @map("term")

  annualFees Int

  age String?

  className String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([academicYear, className])
}

model AcademicYear {
  admissions Admission[]
  feeRecords FeeRecord[]
  id           String    @id @default(cuid())
  academicYear String    @unique
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WorkspaceMember {
  id        String        @id @default(cuid())
  email     String        @unique
  role      WorkspaceRole
  isActive  Boolean       @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([role, isActive])
}

model WorkspaceMemberAudit {
  id           String        @id @default(cuid())
  memberEmail  String
  actorEmail   String
  action       String
  beforeRole   WorkspaceRole?
  afterRole    WorkspaceRole?
  beforeActive Boolean?
  afterActive  Boolean?
  createdAt    DateTime      @default(now())

  @@index([createdAt])
  @@index([memberEmail, createdAt])
}

enum WorkspaceRole {
  ADMIN
  STAFF
}

model AdmissionConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Eligibility {
  id        String   @id @default(cuid())
  age       Int
  className String   @map("class")
  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  NO
  YES
  SUBMITTED
}

enum EntranceStatus {
  NOT_STARTED
  PASS
  FAIL
  PENDING
  NOT_REQUIRED
}

enum InterviewStatus {
  NOT_STARTED
  SELECTED
  REJECTED
  PENDING
}

enum AdmissionGivenStatus {
  NOT_GIVEN
  GIVEN
}

enum FinalAdmissionStatus {
  PENDING
  ADMITTED
  CANCELLED
}

/**
 * Append-only, administrator-readable audit history for record mutations.
 * It excludes phone numbers, dates of birth, and other high-risk personal fields.
 */
model ActivityLog {
  id          String   @id @default(cuid())
  actorEmail  String
  actorName   String?
  actorRole   String
  action      String
  entityType  String
  entityId    String
  entityLabel String
  changes     Json
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorEmail, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
}

/** A single assigned parent follow-up, completed without deleting its history. */
model AdmissionFollowUp {
  id               String         @id @default(cuid())
  admissionId      String
  admission        Admission      @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  assignedToEmail  String
  dueAt            DateTime
  note             String?
  status           FollowUpStatus @default(OPEN)
  outcome          FollowUpOutcome?
  completionNote   String?
  completedAt      DateTime?
  completedByEmail String?
  createdByEmail   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([admissionId, createdAt(sort: Desc)])
  @@index([assignedToEmail, status, dueAt])
  @@index([status, dueAt])
}

enum FollowUpStatus {
  OPEN
  COMPLETED
}

enum FollowUpOutcome {
  INTERESTED
  CALL_BACK
  NO_RESPONSE
  NOT_INTERESTED
  OTHER
}

model PushSubscription {
  id        String   @id @default(cuid())
  email     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model PushDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  followUpId     String
  reminderKind   String
  sentAt         DateTime @default(now())

  @@unique([subscriptionId, followUpId, reminderKind])
  @@index([sentAt])
}

/** Durable, private per-user alerts; eventKey makes retries idempotent. */
model NotificationEvent {
  id            String   @id @default(cuid())
  email         String
  eventKey      String
  type          String
  title         String
  body          String
  href          String   @default("/admissions")
  createdAt     DateTime @default(now())
  readAt        DateTime?
  pushSentAt    DateTime?
  pushClaimedAt DateTime?

  @@unique([email, eventKey])
  @@index([email, createdAt(sort: Desc)])
  @@index([pushSentAt, createdAt])
}

/** Per-account alert preferences. Admin and Staff options are role-restricted. */
model NotificationPreference {
  id           String   @id @default(cuid())
  email        String
  type         String
  inAppEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([email, type])
}
