DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=verify-full"
NEON_AUTH_BASE_URL="https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-at-least-32-random-characters"

# Optional local-development convenience. This is ignored in production.
LOCAL_AUTH_BYPASS="false"

# Admissions production uses Neon for database and authentication.

# Required: comma-separated authorized Neon Auth email addresses.
ADMISSIONS_ADMIN_EMAILS="admin@example.com"
# Optional admission staff members (no fees/year administration).
ADMISSIONS_STAFF_EMAILS=""
